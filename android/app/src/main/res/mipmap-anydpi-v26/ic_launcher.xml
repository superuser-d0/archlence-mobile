<?xml version="1.0" encoding="utf-8"?>
<!--
    What every device from Android 8 onwards actually shows. The PNGs in
    `mipmap-*dpi/` are the fallback for API 24 and 25.

    `<monochrome>` points at the same drawable as `<foreground>`, which is
    correct rather than lazy: Android 13's themed icons take the SHAPE from
    that layer's alpha and supply their own colour, and the mark is already a
    solid silhouette drawn inside the safe zone. A separate file would be the
    same two paths waiting to fall out of step.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
