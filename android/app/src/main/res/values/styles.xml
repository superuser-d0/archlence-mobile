<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process starts, before Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!--
        The window from the moment the process is up: behind the Flutter UI
        while it initialises, and behind it while it runs.

        `Theme.Black` and a fixed dark background even in `values/`, which is
        the LIGHT-mode folder. The template puts `Theme.Light` here and defers
        to `?android:colorBackground`; this app has one theme — Obsidian Prime,
        dark — so a phone in light mode would otherwise flash white on the way
        in and show white in the gap under a resizing keyboard.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
