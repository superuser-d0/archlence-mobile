<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Identical to `values/styles.xml` on purpose. The app is dark-only, so
        there is nothing for dark mode to change — and this file has to exist
        anyway, because leaving it as the template's copy would let a phone in
        dark mode drift away from one in light mode the next time either is
        edited.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
